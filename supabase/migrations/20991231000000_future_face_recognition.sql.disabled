-- FASE 4 (reconhecimento facial) — NÃO APLICADO. Schema previsto, mantido comentado de propósito.
-- Embeddings só podem existir para alunos com students.image_consent_at preenchido (LGPD),
-- e uma detecção só vira presença depois de confirmada pelo professor.
--
-- create extension if not exists vector with schema extensions;
--
-- create table public.face_embeddings (
--   id uuid primary key default gen_random_uuid(),
--   student_id uuid not null references public.students (id) on delete cascade,
--   embedding extensions.vector(512) not null,
--   source_photo_id uuid references public.class_photos (id) on delete set null,
--   created_at timestamptz not null default now()
-- );
-- create index face_embeddings_hnsw on public.face_embeddings
--   using hnsw (embedding extensions.vector_cosine_ops);
