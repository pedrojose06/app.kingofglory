# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publishable (sb_publishable_...) ou a anon legada. Nunca a service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave pública VAPID do Web Push (lembrete de chamada). A privada fica só nos segredos da Edge Function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
